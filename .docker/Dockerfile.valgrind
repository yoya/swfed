# run the tests under valgrind (run-tests.php -m): memory errors and leaks fail the test
FROM php:8.3-cli

SHELL ["/bin/bash", "-c"]

RUN apt-get -y update && \
        apt-get install -y build-essential libpng-dev libgif-dev liblzma-dev valgrind
COPY . /tmp/ext

WORKDIR /tmp/ext/src

RUN phpize && ./configure CFLAGS="-g -O1" && make

# a test that valgrind complains about is only reported as LEAK: print what valgrind wrote
CMD make test NO_INTERACTION=1 TESTS="-m --show-diff"; rc=$?; \
    for f in tests/*.mem; do if [ -s "$f" ]; then echo "==== valgrind: $f"; cat "$f"; fi; done; exit $rc
